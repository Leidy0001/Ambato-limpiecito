lines_pending = Array[String](["¡Hola! Bienvenido a la Quinta de Juan León Mera.", "Unas criaturas de basura mutada aparecieron en los jardines y todo perdió su color.", "La más grande, el Plasti-Gólem, está al este, junto al agua. ¿Me ayudas a purificarla?", "Acércate y pulsa E para enfrentarla. ¡Usa tus ataques ecológicos!"])
