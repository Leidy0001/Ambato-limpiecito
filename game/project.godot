; Engine configuration file.
config_version=5

[application]
config/name="Ambato Limpiecito"
config/description="RPG 2D para promocionar Ingeniería de Software (FISEI-UTA) y el cuidado de Ambato."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3")

[autoload]
GameState="*res://scripts/autoload/game_state.gd"
MissionManager="*res://scripts/autoload/mission_manager.gd"

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[input]
move_up={"deadzone": 0.5, "events": []}
move_down={"deadzone": 0.5, "events": []}
move_left={"deadzone": 0.5, "events": []}
move_right={"deadzone": 0.5, "events": []}
interact={"deadzone": 0.5, "events": []}

[rendering]
textures/canvas_textures/default_texture_filter=0
